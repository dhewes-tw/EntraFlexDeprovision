# Copy to .env and fill in. The script auto-loads .env from its own directory.
# Do not commit .env to source control.

# Entra ID app registration (client credentials flow)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Trigger mode: 'group' (default) or 'app'.
#   group — process users ADDED to ENTRA_GROUP_ID
#   app   — process users UNASSIGNED from ENTRA_ENTERPRISE_APP_SID
# TRIGGER_MODE=group

# Object ID of the Entra group to watch (required when TRIGGER_MODE=group)
ENTRA_GROUP_ID=

# Object ID of the Entra Enterprise Application's service principal
# (required when TRIGGER_MODE=app). Find in Entra portal → Enterprise
# applications → your app → Properties → Object ID.
# ENTRA_ENTERPRISE_APP_SID=

# Twilio API Key (SK...) and its secret, plus the Flex Instance SID (GO...)
TWILIO_API_KEY=
TWILIO_API_SECRET=
FLEX_INSTANCE_SID=

# Optional: enable TaskRouter Worker cleanup. When set to a truthy value
# (1, true, yes, on), the script will also look up and DELETE the matching
# TaskRouter Worker (matched by FriendlyName = the Flex username) for each new
# Entra member. Default is disabled.
# DELETE_TASKROUTER_WORKER=1

# Optional: TaskRouter Workspace SID (WS...). Only used when
# DELETE_TASKROUTER_WORKER is enabled. If unset, the script auto-discovers it
# from Flex Configuration. Set this to skip the discovery call, or if your API
# key can't read Flex Configuration.
# TASKROUTER_WORKSPACE_SID=

# Optional: which Entra user field(s) to use as the Flex Username.
# Comma-separated priority list — first non-empty value wins.
# Scalar fields: mail, userPrincipalName, onPremisesUserPrincipalName
# Array fields:  otherMails, proxyAddresses  (first non-empty element is used;
#                proxyAddresses "SMTP:"/"smtp:" prefix is stripped automatically)
# Default: mail,userPrincipalName
# ENTRA_EMAIL_FIELD=mail,userPrincipalName

# Optional: set DEBUG=1 to print each Graph member's fields (including a filtered
# list of every value containing "@") so you can pick the right ENTRA_EMAIL_FIELD.
# DEBUG=1
